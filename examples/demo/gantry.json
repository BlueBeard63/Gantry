{
  "$schema": "https://raw.githubusercontent.com/B-Commissions/Gantry/main/gantry.schema.json",
  "name": "demo",
  "title": "Demo",
  "version": "0.1.0",
  "port": 8330,
  "mode": "multi",
  "style": "tea",
  "tray": true,
  "buttons": {
    "minimize": true,
    "maximize": true,
    "close": true
  },
  "args": {
    "mock-data": {
      "type": "bool",
      "default": false,
      "description": "serve fake data instead of the real backend"
    },
    "api-host": {
      "type": "string",
      "default": "localhost",
      "description": "backend host the app talks to"
    }
  },
  "mobile": {
    "id": "ec.morrison.demo",
    "permissions": ["notifications"],
    "widgets": [
      {
        "name": "status",
        "label": "Demo Status",
        "minSize": "3x1",
        "maxSize": "5x2",
        "refreshMinutes": 30
      }
    ]
  }
}
