// Synthesized by gantry build - regenerated every run, never hand-edited.
package [[.ID]]

import android.content.Context
import android.content.pm.ApplicationInfo
import android.util.Base64
import android.util.Log
import java.io.BufferedReader
import java.io.File
import java.io.InputStreamReader
import java.security.SecureRandom

// GoBackend runs the app's Go server - packed into the APK as
// jniLibs/<abi>/libgantryapp.so so Android extracts it executable into
// nativeLibraryDir - as a child process, and restarts it with backoff
// if it dies. The server binds an ephemeral port (--port 0) and
// announces it on stdout; every stdout line is relayed to logcat under
// the "gantry-go" tag.
class GoBackend(private val context: Context) {
    // token guards the loopback server: only pages opened by this shell
    // (which appends ?gantry_token= on the first load) can talk to it.
    // A test run (below) substitutes the runner's own token.
    private val randomToken: String = ByteArray(16).let { b ->
        SecureRandom().nextBytes(b)
        b.joinToString("") { "%02x".format(it) }
    }
    val token: String get() = testToken ?: randomToken

    private val lock = Object()
    private var port = 0
    private val listeners = mutableListOf<(Int) -> Unit>()
    private val onceListeners = mutableListOf<(Int) -> Unit>()
    @Volatile private var stopped = false

    // Test overrides (gantry test --device android): a debuggable build
    // honors a runner-chosen fixed port, token and extra server
    // environment, so the test runner can adb-forward to a port it
    // knows and authenticate with a token it chose. The runner writes
    // them (base64ed: port, token, then K=V env lines) into
    // files/.gantry-test.config through run-as before am start -
    // readable here before the first spawn, so the crash.log handoff is
    // never consumed by a throwaway pre-config server - and repeats
    // them as intent extras, which applyTestConfig treats as a no-op
    // confirmation (or a config change to restart into). A
    // test-configured server also stays dead when it exits: the runner
    // owns relaunches (its WaitExit/Restart semantics), so the
    // supervisor restart below is suspended.
    @Volatile private var testPort = 0
    @Volatile private var testToken: String? = null
    @Volatile private var testEnv: Map<String, String> = emptyMap()
    @Volatile private var current: Process? = null

    // isTestConfigured reports whether this launch is under gantry test
    // (a runner-chosen port was injected). The activity uses it to skip
    // the first-launch permission prompt: a test controls permissions
    // explicitly (adb pm grant/revoke), and a prompt would occlude the
    // WebView and pause it.
    val isTestConfigured: Boolean get() = testPort != 0

    private fun debuggable() =
        (context.applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE) != 0

    private fun parseTestEnv(lines: List<String>): Map<String, String> {
        val env = HashMap<String, String>()
        for (line in lines) {
            val i = line.indexOf('=')
            if (i > 0) env[line.substring(0, i)] = line.substring(i + 1)
        }
        return env
    }

    private fun loadTestConfig() {
        if (!debuggable()) return
        val f = File(context.filesDir, ".gantry-test.config")
        val b64 = try {
            f.readText().trim()
        } catch (e: Exception) {
            return
        }
        if (b64.isEmpty()) return
        val lines = String(Base64.decode(b64, Base64.DEFAULT)).split('\n')
        if (lines.size < 2) return
        val filePort = lines[0].toIntOrNull() ?: 0
        if (filePort == 0 || lines[1].isEmpty()) return
        testPort = filePort
        testToken = lines[1]
        testEnv = parseTestEnv(lines.drop(2))
        Log.i(TAG, "test config from ${f.name}: port=$filePort")
    }

    fun applyTestConfig(newPort: Int, newToken: String, envB64: String?) {
        if (!debuggable()) return
        val env = if (envB64.isNullOrEmpty()) {
            emptyMap()
        } else {
            parseTestEnv(String(Base64.decode(envB64, Base64.DEFAULT)).split('\n'))
        }
        synchronized(lock) {
            if (testPort == newPort && testToken == newToken && testEnv == env) return
            testPort = newPort
            testToken = newToken
            testEnv = env
            port = 0
        }
        Log.i(TAG, "test config: port=$newPort - restarting the server")
        current?.destroy()
    }

    // onReady runs cb (on a backend thread) with the server's port -
    // immediately if it is already up, and again with the new port after
    // every restart, so callers can re-point the WebView.
    fun onReady(cb: (Int) -> Unit) {
        synchronized(lock) {
            listeners.add(cb)
            if (port != 0) cb(port)
        }
    }

    // onceReady runs cb exactly once - now if the server is up, else on
    // its next ready announcement (used by fire-and-forget relays).
    fun onceReady(cb: (Int) -> Unit) {
        synchronized(lock) {
            if (port != 0) {
                cb(port)
            } else {
                onceListeners.add(cb)
            }
        }
    }

    fun start() {
        loadTestConfig()
        Thread(::runLoop, "gantry-backend").apply { isDaemon = true }.start()
    }

    private fun runLoop() {
        var backoffMs = 500L
        while (!stopped) {
            val cfgPort = testPort
            val startedAt = System.currentTimeMillis()
            try {
                runOnce()
            } catch (e: Exception) {
                Log.e(TAG, "backend failed", e)
            }
            if (stopped) return
            // A test config landing mid-run means this run was the
            // pre-config spawn: relaunch with the overrides right away.
            if (testPort != cfgPort) continue
            // A test-configured server stays dead; the runner relaunches.
            if (cfgPort != 0) return
            // A run that survived a while was healthy: reset the backoff.
            if (System.currentTimeMillis() - startedAt > 30_000) backoffMs = 500L
            Log.w(TAG, "backend exited, restarting in ${backoffMs}ms")
            try {
                Thread.sleep(backoffMs)
            } catch (e: InterruptedException) {
                return
            }
            backoffMs = (backoffMs * 2).coerceAtMost(15_000L)
        }
    }

    private fun runOnce() {
        val cfgPort = testPort
        val cfgToken = token
        val exe = File(context.applicationInfo.nativeLibraryDir, "libgantryapp.so")
        val pb = ProcessBuilder(
            exe.absolutePath,
            "--port", cfgPort.toString(), "--no-open", "--announce-ready",
            "--token", cfgToken,
        )
        pb.environment()["HOME"] = context.filesDir.absolutePath
        pb.environment()["TMPDIR"] = context.cacheDir.absolutePath
        pb.environment().putAll(testEnv)
        pb.redirectErrorStream(true)
        val p = pb.start()
        current = p
        // A test config that raced in between the snapshot above and
        // start: kill the stale spawn, the loop relaunches with it.
        if (testPort != cfgPort || token != cfgToken) p.destroy()
        BufferedReader(InputStreamReader(p.inputStream)).useLines { lines ->
            for (line in lines) {
                // Control lines let the server drive shell-side Android
                // APIs it cannot reach itself; everything else is log.
                when {
                    line.startsWith("GANTRY_NOTIFY ") ->
                        Notifier.post(context, line.removePrefix("GANTRY_NOTIFY "))
                    line.startsWith("GANTRY_NOTIFY_CLEAR ") ->
                        Notifier.clear(context, line.removePrefix("GANTRY_NOTIFY_CLEAR "))
                    else -> {
                        Log.i(TAG, line)
                        READY.find(line)?.let { m -> announceReady(m.groupValues[1].toInt()) }
                    }
                }
            }
        }
        p.waitFor()
    }

    // announceReady records the (possibly new) port and wakes everyone
    // waiting on the server.
    private fun announceReady(newPort: Int) {
        val toNotify = synchronized(lock) {
            port = newPort
            val once = onceListeners.toList()
            onceListeners.clear()
            listeners.toList() + once
        }
        toNotify.forEach { it(newPort) }
[[if .Widgets]]        // The server is up anyway: refresh the widgets for free.
        Thread { WidgetRefresh.fromServer(context, newPort, token) }.start()
[[end]]    }

    companion object {
        private const val TAG = "gantry-go"
        private val READY = Regex("""^GANTRY_READY port=(\d+)$""")
    }
}
